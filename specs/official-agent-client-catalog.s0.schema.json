{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/official-agent-client-catalog.s0.schema.json",
  "title": "NOEMA Official Agent Client Catalog (S0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "official_repo",
    "new_verbs",
    "new_events",
    "new_player_classes",
    "browser_canonical",
    "client_is_world_authority",
    "provider_neutral",
    "discovery_first",
    "seal_fail_closed",
    "copy_first",
    "admin_secrets_forbidden",
    "mcp_required",
    "operator_brief_flags_forbidden"
  ],
  "properties": {
    "schema_version": { "const": "official-agent-client-catalog/s0" },
    "catalog_id": { "const": "official-agent-client-catalog/s0" },
    "slice_id": { "const": "official-agent-client-s0" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "official_repo": { "const": "scrimshawlife-ctrl/noema-client" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_player_classes": { "type": "array", "maxItems": 0 },
    "browser_canonical": { "const": false },
    "client_is_world_authority": { "const": false },
    "provider_neutral": { "const": true },
    "discovery_first": { "const": true },
    "seal_fail_closed": { "const": true },
    "copy_first": { "const": true },
    "admin_secrets_forbidden": { "const": true },
    "mcp_required": { "const": false },
    "operator_brief_flags_forbidden": { "const": true }
  }
}
