{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/authority-catalog.gc4-s4.schema.json",
  "title": "NOEMA Authority Catalog (GC4-S4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "extends",
    "mechanism",
    "operations",
    "new_verbs",
    "new_events",
    "max_successors",
    "designators",
    "holder_may_designate",
    "implicit_jump",
    "disconnect_triggers",
    "controller_change_triggers",
    "dormant_triggers",
    "retire_office_succeeds",
    "dissolved_activates",
    "emergency_resets_duration",
    "transfers_reputation",
    "transfers_private_knowledge",
    "transfers_treasury"
  ],
  "properties": {
    "schema_version": { "const": "authority-catalog/gc4-s4" },
    "catalog_id": { "const": "authority-catalog/gc4-s4" },
    "slice_id": { "const": "gc4-s4" },
    "authority": { "type": "string" },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.1" },
    "extends": { "const": "authority-catalog/gc4-s3" },
    "mechanism": { "const": "DESIGNATED" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "const": "ORG_SUCCESSION_DESIGNATE" }],
      "items": false
    },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "max_successors": { "const": 2 },
    "designators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "const": "founder" }, { "const": "officer" }],
      "items": false
    },
    "holder_may_designate": { "const": false },
    "implicit_jump": { "const": false },
    "disconnect_triggers": { "const": false },
    "controller_change_triggers": { "const": false },
    "dormant_triggers": { "const": false },
    "retire_office_succeeds": { "const": false },
    "dissolved_activates": { "const": false },
    "emergency_resets_duration": { "const": false },
    "transfers_reputation": { "const": false },
    "transfers_private_knowledge": { "const": false },
    "transfers_treasury": { "const": false }
  }
}
