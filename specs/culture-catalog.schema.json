{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/culture-catalog.schema.json",
  "title": "NOEMA Culture Catalog (GC9-S0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "lineage_schema",
    "lineage_kind",
    "evidence_event",
    "practice",
    "custom_threshold",
    "practicing_threshold",
    "custom_line",
    "new_verbs",
    "new_events",
    "ledger_write",
    "lore_overrides_ledger",
    "v06c",
    "procedural_generator",
    "watch_projection",
    "public_projection",
    "forbidden_in_projection"
  ],
  "properties": {
    "schema_version": { "const": "culture-catalog/gc9-s0" },
    "catalog_id": { "const": "culture-catalog/gc9-s0" },
    "slice_id": { "const": "gc9-s0" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "lineage_schema": { "const": "semantic-lineage/0.6" },
    "lineage_kind": { "const": "CUSTOM" },
    "evidence_event": { "const": "ENTITY_UPDATE" },
    "practice": { "const": "REPAIR" },
    "custom_threshold": { "const": 3 },
    "practicing_threshold": { "const": 1 },
    "custom_line": { "type": "string", "minLength": 1 },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "ledger_write": { "const": false },
    "lore_overrides_ledger": { "const": false },
    "v06c": { "const": false },
    "procedural_generator": { "const": false },
    "watch_projection": { "const": false },
    "public_projection": { "const": false },
    "forbidden_in_projection": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
