{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/diplomacy-attempt.s1.schema.json",
  "title": "NOEMA Diplomacy S1 attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "diplomacy-s1" },
    "catalog_id": { "const": "diplomacy-catalog/s1" },
    "operation": { "enum": ["AGREEMENT_TERMINATE", "HELP_OMIT"] },
    "has_reason": { "type": "boolean" },
    "is_party": { "type": "boolean" },
    "status": { "enum": ["ACTIVE", "OFFERED", "BROKEN"] },
    "topic": { "type": "string" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "reason": { "type": "string" },
        "listed": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
