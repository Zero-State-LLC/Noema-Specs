{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/economy-catalog.schema.json",
  "title": "NOEMA Economy Catalog (GC8-S0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "verbs",
    "new_verbs",
    "new_events",
    "harvest_energy",
    "move_energy",
    "trade_compute",
    "trade_requires_colocation",
    "harvest_requires_colocation",
    "currency",
    "order_book",
    "global_price_index",
    "v06b",
    "mastery_yield_bonus",
    "lot_quality",
    "storage_loss",
    "wallet",
    "crypto",
    "npc_shop"
  ],
  "properties": {
    "schema_version": { "const": "economy-catalog/gc8-s0" },
    "catalog_id": { "const": "economy-catalog/gc8-s0" },
    "slice_id": { "const": "gc8-s0" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "verbs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "HARVEST" },
        { "const": "MOVE" },
        { "const": "TRADE" }
      ],
      "items": false
    },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "harvest_energy": { "const": 2 },
    "move_energy": { "const": 1 },
    "trade_compute": { "const": 1 },
    "trade_requires_colocation": { "const": false },
    "harvest_requires_colocation": { "const": true },
    "currency": { "const": false },
    "order_book": { "const": false },
    "global_price_index": { "const": false },
    "v06b": { "const": false },
    "mastery_yield_bonus": { "const": false },
    "lot_quality": { "const": false },
    "storage_loss": { "const": false },
    "wallet": { "const": false },
    "crypto": { "const": false },
    "npc_shop": { "const": false }
  }
}
