{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/conflict-catalog.gc7-s1.schema.json",
  "title": "NOEMA Conflict Catalog (GC7-S1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "resolve_event",
    "declarer_withdraw_outcome",
    "defender_withdraw_outcome",
    "new_verbs",
    "new_events",
    "hp_combat",
    "withdraw",
    "auto_move",
    "idle_withdraws",
    "refund_fees"
  ],
  "properties": {
    "schema_version": { "const": "conflict-catalog/gc7-s1" },
    "catalog_id": { "const": "conflict-catalog/gc7-s1" },
    "slice_id": { "const": "gc7-s1" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.2" },
    "extends": { "const": "conflict-catalog/gc7-s0" },
    "resolve_event": { "const": "CONTEST_RESOLVED" },
    "declarer_withdraw_outcome": { "const": "ABORTED" },
    "defender_withdraw_outcome": { "const": "SUCCESS" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_forms": { "type": "array", "maxItems": 0 },
    "hp_combat": { "const": false },
    "character_death": { "const": false },
    "withdraw": { "const": true },
    "auto_move": { "const": false },
    "idle_withdraws": { "const": false },
    "refund_fees": { "const": false },
    "declarer_stake_on_declarer_withdraw": { "enum": ["CONSUME"] },
    "defender_stake_on_declarer_withdraw": { "enum": ["RELEASE"] },
    "declarer_stake_on_defender_withdraw": { "enum": ["CONSUME"] },
    "defender_stake_on_defender_withdraw": { "enum": ["CONSUME"] },
    "danger_on_aborted": { "const": false },
    "forbidden_in_projection": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
