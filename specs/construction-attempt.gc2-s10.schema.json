{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s10.schema.json",
  "title": "NOEMA GC2-S10 institution vest attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s10" },
    "catalog_id": { "const": "construction-catalog/gc2-s10" },
    "operation": { "enum": ["VEST"] },
    "room_hidden": { "type": "boolean" },
    "personal_owner": { "type": "boolean" },
    "office_occupied": { "type": "boolean" },
    "unclaimed": { "type": "boolean" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "same_entity": { "type": "boolean" },
        "owner": { "enum": ["player", "institution"] },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
