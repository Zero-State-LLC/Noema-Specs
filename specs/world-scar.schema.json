{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/world-scar.schema.json",
  "title": "NOEMA world-scar (v0.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scar_id",
    "scar_type",
    "location_ref",
    "origin_cycle",
    "derived_from_event_refs",
    "observable",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "world-scar/0.6"
    },
    "scar_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "scar_type": {
      "enum": [
        "DAMAGED_INFRASTRUCTURE",
        "ABANDONED_STRUCTURE",
        "RESOURCE_DEPLETION",
        "RESTRICTED_RUIN",
        "MEMORIAL",
        "ARCHIVAL_SITE",
        "OLD_BOUNDARY"
      ]
    },
    "location_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "origin_cycle": {
      "type": "integer",
      "minimum": 0
    },
    "derived_from_event_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observable": {
      "type": "boolean"
    },
    "strategic_effect": {
      "type": "string"
    },
    "simple_label": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
