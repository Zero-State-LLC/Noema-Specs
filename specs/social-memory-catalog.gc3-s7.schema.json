{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/social-memory-catalog.gc3-s7.schema.json",
  "title": "NOEMA Social Memory Catalog (GC3-S7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "reliable_threshold",
    "waive_caution",
    "auto_accept",
    "hide_others",
    "hidden_rebate",
    "base_compute_zero",
    "reputation_scalar",
    "new_verbs",
    "public_projection",
    "watch_projection",
    "prefer_line",
    "forbidden_in_projection"
  ],
  "properties": {
    "schema_version": { "const": "social-memory-catalog/gc3-s7" },
    "catalog_id": { "const": "social-memory-catalog/gc3-s7" },
    "slice_id": { "const": "gc3-s7" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "reliable_threshold": { "const": 3 },
    "waive_caution": { "const": true },
    "auto_accept": { "const": false },
    "hide_others": { "const": false },
    "hidden_rebate": { "const": false },
    "base_compute_zero": { "const": false },
    "reputation_scalar": { "const": false },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "public_projection": { "const": false },
    "watch_projection": { "const": false },
    "prefer_line": { "type": "string" },
    "forbidden_in_projection": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
