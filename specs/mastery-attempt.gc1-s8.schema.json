{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/mastery-attempt.gc1-s8.schema.json",
  "title": "NOEMA GC1-S8 overhaul attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "extent", "expected"],
  "properties": {
    "slice_id": { "const": "gc1-s8" },
    "catalog_id": { "const": "mastery-catalog/gc1-s8" },
    "operation": { "const": "REPAIR" },
    "extent": { "enum": ["standard", "overhaul"] },
    "track": { "enum": ["explorer", "surveyor", "broker", "engineer"] },
    "recognized": { "type": "boolean" },
    "latent": { "type": "boolean" },
    "energy": { "type": "integer", "minimum": 0 },
    "label": { "type": "string" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "reason": { "type": "string" },
        "extra_energy": { "type": "integer" },
        "extra_condition": { "type": "integer" },
        "line": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
