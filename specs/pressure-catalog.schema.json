{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/pressure-catalog.schema.json",
  "title": "NOEMA Pressure Catalog (GC10-S0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "pressure_class",
    "activate_event",
    "forbidden_activate_event",
    "condition_delta",
    "first_cycle",
    "max_activations_cycles_1_20",
    "min_condition_after",
    "authorizers",
    "forbidden_authorizers",
    "required_response",
    "play_research_labels",
    "admin_spawn",
    "share_frontier_ids",
    "reversible",
    "restore_verb",
    "new_verbs",
    "new_events"
  ],
  "properties": {
    "schema_version": { "const": "pressure-catalog/gc10-s0" },
    "catalog_id": { "const": "pressure-catalog/gc10-s0" },
    "slice_id": { "const": "gc10-s0" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.1" },
    "pressure_class": { "const": "infrastructure_failure" },
    "activate_event": { "const": "ENTITY_UPDATE" },
    "forbidden_activate_event": { "const": "SITUATION_INJECTED" },
    "condition_delta": { "const": 15 },
    "first_cycle": { "const": 4 },
    "max_activations_cycles_1_20": { "const": 1 },
    "min_condition_after": { "const": 25 },
    "authorizers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "const": "schedule" }, { "const": "operator" }],
      "items": false
    },
    "forbidden_authorizers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{ "const": "player" }, { "const": "llm" }, { "const": "study" }],
      "items": false
    },
    "required_response": { "const": false },
    "play_research_labels": { "const": false },
    "admin_spawn": { "const": false },
    "share_frontier_ids": { "const": false },
    "reversible": { "const": true },
    "restore_verb": { "const": "REPAIR" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 }
  }
}
