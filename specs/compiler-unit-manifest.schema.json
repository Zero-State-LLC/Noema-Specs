{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/compiler-unit-manifest.schema.json",
  "title": "NOEMA compiler-unit-manifest (v0.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "compile_id",
    "units",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "compiler-unit-manifest/0.5"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "compile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "unit_type",
          "layer",
          "source_ref",
          "protected",
          "dependencies",
          "eligible_for_removal",
          "final_disposition"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "unit_type": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "WORLD_CONFIGURATION",
              "ENTITIES_AGENTS",
              "EVENTS_ACTIONS",
              "OBSERVATIONS_MESSAGES",
              "TOOLS_RESOURCES",
              "METADATA"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "protected": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "eligible_for_removal": {
            "type": "boolean"
          },
          "final_disposition": {
            "enum": [
              "RETAINED",
              "REMOVED",
              "PROTECTED",
              "INELIGIBLE"
            ]
          },
          "simple_label": {
            "type": "string"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
