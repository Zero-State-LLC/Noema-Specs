{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/intervention.schema.json",
  "title": "NOEMA Intervention (v0.4 Lab)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intervention_id",
    "type",
    "target",
    "application_point",
    "scope",
    "duration",
    "restore_rule",
    "seed_policy",
    "expected_mechanical_effect",
    "forbidden_side_effects",
    "authorization",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "intervention/0.4"
    },
    "intervention_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "type": {
      "enum": [
        "PERTURBATION",
        "ABLATION",
        "LESION",
        "COUNTERFACTUAL",
        "REPLICATION",
        "VERSION_DIFFERENTIAL"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "VARIABLE",
            "TOOL",
            "MODULE",
            "CHANNEL",
            "ARTIFACT",
            "AGENT_VERSION",
            "WORLD_PARAM"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "target_version": {
      "type": "string"
    },
    "application_point": {
      "enum": [
        "BEFORE_OBSERVATION",
        "AFTER_OBSERVATION",
        "BEFORE_ACTION",
        "AFTER_ACTION",
        "CYCLE_BOUNDARY",
        "BEFORE_FRONTIER_INJECTION",
        "AFTER_FRONTIER_INJECTION",
        "FORK_BOUNDARY"
      ]
    },
    "before_reference": {},
    "after_reference": {},
    "scope": {
      "enum": [
        "RUN",
        "FORK",
        "AGENT",
        "ROOM",
        "WORLD_FORK"
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PERMANENT_UNTIL_RESTORE",
            "CYCLES",
            "UNTIL_RUN_END"
          ]
        },
        "cycles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "restore_rule": {
      "enum": [
        "AUTO_ON_RUN_END",
        "EXPLICIT",
        "NONE_FORK_DISCARD"
      ]
    },
    "seed_policy": {
      "enum": [
        "SAME_SEED",
        "DERIVED_SEED",
        "INDEPENDENT_SEED"
      ]
    },
    "expected_mechanical_effect": {
      "type": "string",
      "maxLength": 1024
    },
    "forbidden_side_effects": {
      "type": "array",
      "items": {
        "enum": [
          "PRODUCTION_WORLD_MUTATION",
          "LEDGER_APPEND_TO_SOURCE",
          "UNDECLARED_RNG",
          "PRIVATE_COGNITION_READ",
          "REWARD_INJECTION"
        ]
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_by"
      ],
      "properties": {
        "authorized_by": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "lesion_capability": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "catalog_entry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
