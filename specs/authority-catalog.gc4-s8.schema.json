{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/authority-catalog.gc4-s8.schema.json",
  "title": "NOEMA Authority Catalog (GC4-S8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "rfc",
    "mechanism",
    "operation",
    "new_verbs",
    "new_events",
    "government_entity",
    "elections",
    "free_form_text_authority",
    "empty_jurisdiction_is_universal",
    "undefined_failure_fails_closed",
    "grants_new_authority",
    "watch_public"
  ],
  "properties": {
    "schema_version": { "const": "authority-catalog/gc4-s8" },
    "catalog_id": { "const": "authority-catalog/gc4-s8" },
    "slice_id": { "const": "gc4-s8" },
    "authority": { "type": "string" },
    "rfc": { "type": "string" },
    "extends": { "type": "string" },
    "mechanism": { "const": "GOVERNANCE_RULE" },
    "operation": { "type": "string" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "event_catalog": { "const": "event-catalog/0.1" },
    "government_entity": { "const": false },
    "elections": { "const": false },
    "free_form_text_authority": { "const": false },
    "empty_jurisdiction_is_universal": { "const": false },
    "undefined_failure_fails_closed": { "const": true },
    "grants_new_authority": { "const": false },
    "watch_public": { "const": false }
  }
}
