{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/mastery-attempt.gc1-s7.schema.json",
  "title": "NOEMA GC1-S7 focus attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc1-s7" },
    "catalog_id": { "const": "mastery-catalog/gc1-s7" },
    "operation": { "enum": ["FOCUS", "FOCUS_CLEAR"] },
    "track": { "enum": ["explorer", "surveyor", "broker", "engineer"] },
    "viewer": { "enum": ["self", "other", "watch"] },
    "handle": { "type": "string" },
    "latent": { "type": "boolean" },
    "hidden_room": { "type": "boolean" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "reason": { "type": "string" },
        "line": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
