{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-catalog.gc5-s13.schema.json",
  "title": "NOEMA Communication Catalog (GC5-S13)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "surface",
    "help_market",
    "watch_trade_notice",
    "hidden_stall",
    "auto_trade",
    "price_oracle",
    "retention",
    "expire_cycles"
  ],
  "properties": {
    "schema_version": { "const": "communication-catalog/gc5-s13" },
    "catalog_id": { "const": "communication-catalog/gc5-s13" },
    "slice_id": { "const": "gc5-s13" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "communication-catalog/gc5-s12" },
    "verb": { "const": "MESSAGE" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "surface": { "const": "TRADE_NOTICE" },
    "help_market": { "const": false },
    "watch_trade_notice": { "const": false },
    "hidden_stall": { "const": false },
    "auto_trade": { "const": false },
    "price_oracle": { "const": false },
    "retention": { "const": 1 },
    "expire_cycles": { "const": 1 },
    "cost_compute": { "const": 1 }
  }
}
