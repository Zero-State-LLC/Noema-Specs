{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s3.schema.json",
  "title": "NOEMA GC2-S3 defensive_work attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s3" },
    "catalog_id": { "const": "construction-catalog/gc2-s3" },
    "operation": { "enum": ["CONSTRUCT", "SCORE"] },
    "class_id": { "type": "string" },
    "room_hidden": { "type": "boolean" },
    "has_defensive_work": { "type": "boolean" },
    "base_score": { "type": "integer" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "score": { "type": "integer" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
