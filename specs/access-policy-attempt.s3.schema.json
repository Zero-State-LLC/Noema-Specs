{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/access-policy-attempt.s3.schema.json",
  "title": "NOEMA ACCESS_POLICY S3 attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "access-policy-s3" },
    "catalog_id": { "const": "access-policy-catalog/s3" },
    "operation": { "enum": ["HELP_ACCESS", "HELP_OMIT"] },
    "topic": { "type": "string" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "listed": { "type": "boolean" },
        "schema_name": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
