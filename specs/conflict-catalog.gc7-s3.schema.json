{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/conflict-catalog.gc7-s3.schema.json",
  "title": "NOEMA Conflict Catalog (GC7-S3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "new_verbs",
    "new_events",
    "new_forms",
    "hp_combat",
    "help_lists_contest",
    "mutates_event_catalog_02",
    "rewrites_archive_claim",
    "hidden_distinct_from_missing",
    "target_entity_type",
    "follow_on_event",
    "acting_for_profile"
  ],
  "properties": {
    "schema_version": { "const": "conflict-catalog/gc7-s3" },
    "catalog_id": { "const": "conflict-catalog/gc7-s3" },
    "slice_id": { "const": "gc7-s3" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.2" },
    "extends": { "const": "conflict-catalog/gc7-s2" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "INFORMATION_CONTEST" }
    },
    "hp_combat": { "const": false },
    "character_death": { "const": false },
    "help_lists_contest": { "const": false },
    "mutates_event_catalog_02": { "const": false },
    "rewrites_archive_claim": { "const": false },
    "hidden_distinct_from_missing": { "const": false },
    "target_entity_type": { "const": "ARTIFACT" },
    "follow_on_event": { "const": "ENTITY_UPDATE" },
    "follow_on_field": { "const": "inspect_restricted_until" },
    "seal_success_cycles": { "type": "integer", "const": 8 },
    "seal_partial_cycles": { "type": "integer", "const": 4 },
    "acting_for_profile": { "const": "ACCESS_RESTRICTED_ARCHIVE" },
    "unknown_forms_forbidden": { "const": true }
  }
}
