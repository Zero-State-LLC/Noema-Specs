{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s6.schema.json",
  "title": "NOEMA GC2-S6 REPURPOSE attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s6" },
    "catalog_id": { "const": "construction-catalog/gc2-s6" },
    "operation": { "const": "REPURPOSE" },
    "from_class": { "type": "string" },
    "to_class": { "type": "string" },
    "entity_id": { "type": "string" },
    "room_hidden": { "type": "boolean" },
    "owned": { "type": "boolean" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "entity_id": { "type": "string" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
