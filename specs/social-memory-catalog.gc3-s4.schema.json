{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/social-memory-catalog.gc3-s4.schema.json",
  "title": "NOEMA Social Memory Catalog (GC3-S4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "decay_cycles",
    "rehab_trades",
    "wipe_verb",
    "ledger_forget",
    "reputation_scalar",
    "new_verbs",
    "public_projection",
    "watch_projection",
    "forbidden_in_projection"
  ],
  "properties": {
    "schema_version": { "const": "social-memory-catalog/gc3-s4" },
    "catalog_id": { "const": "social-memory-catalog/gc3-s4" },
    "slice_id": { "const": "gc3-s4" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "decay_cycles": { "const": 12 },
    "rehab_trades": { "const": 3 },
    "wipe_verb": { "const": false },
    "ledger_forget": { "const": false },
    "reputation_scalar": { "const": false },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "public_projection": { "const": false },
    "watch_projection": { "const": false },
    "forbidden_in_projection": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
