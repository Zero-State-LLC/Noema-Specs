{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s5.schema.json",
  "title": "NOEMA GC2-S5 UPGRADE attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s5" },
    "catalog_id": { "const": "construction-catalog/gc2-s5" },
    "operation": { "enum": ["UPGRADE", "CONSTRUCT", "REPAIR"] },
    "class_id": { "type": "string" },
    "room_hidden": { "type": "boolean" },
    "owned": { "type": "boolean" },
    "already_upgraded": { "type": "boolean" },
    "has_upgraded_workshop": { "type": "boolean" },
    "base_storage": { "type": "integer", "minimum": 0 },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "storage_cost": { "type": "integer" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
