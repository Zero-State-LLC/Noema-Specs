{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-catalog.gc5-s6.schema.json",
  "title": "NOEMA Communication Catalog (GC5-S6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "surface",
    "notice_verb",
    "org_channel",
    "long_range_notice",
    "hidden_notice",
    "watch_notice",
    "help_notice",
    "requires_office",
    "retention",
    "board_retention",
    "shout_retention"
  ],
  "properties": {
    "schema_version": { "const": "communication-catalog/gc5-s6" },
    "catalog_id": { "const": "communication-catalog/gc5-s6" },
    "slice_id": { "const": "gc5-s6" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "communication-catalog/gc5-s5" },
    "verb": { "const": "MESSAGE" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "surface": { "const": "NOTICE" },
    "notice_verb": { "const": false },
    "org_channel": { "const": false },
    "long_range_notice": { "const": false },
    "hidden_notice": { "const": false },
    "watch_notice": { "const": false },
    "help_notice": { "const": false },
    "requires_office": { "const": "PUBLISH_NOTICE" },
    "retention": { "const": 1 },
    "board_retention": { "const": 5 },
    "shout_retention": { "const": 1 },
    "cost_compute": { "const": 1 }
  }
}
