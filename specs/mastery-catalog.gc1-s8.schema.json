{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/mastery-catalog.gc1-s8.schema.json",
  "title": "NOEMA Mastery Catalog (GC1-S8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "verb",
    "operation",
    "parameter",
    "extents",
    "new_verbs",
    "new_events",
    "class_discount",
    "overhaul_track",
    "overhaul_requires_recognized",
    "overhaul_requires_maintained",
    "overhaul_energy_extra",
    "overhaul_condition_extra",
    "condition_cap",
    "success_line"
  ],
  "properties": {
    "schema_version": { "const": "mastery-catalog/gc1-s8" },
    "catalog_id": { "const": "mastery-catalog/gc1-s8" },
    "slice_id": { "const": "gc1-s8" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "mastery-catalog/gc1-s7" },
    "verb": { "const": "COMMIT" },
    "operation": { "const": "REPAIR" },
    "parameter": { "const": "extent" },
    "extents": { "const": ["standard", "overhaul"] },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "class_discount": { "const": false },
    "overhaul_track": { "const": "engineer" },
    "overhaul_requires_recognized": { "const": true },
    "overhaul_requires_maintained": { "const": true },
    "overhaul_energy_extra": { "const": 1 },
    "overhaul_condition_extra": { "const": 5 },
    "condition_cap": { "const": 100 },
    "success_line": { "const": "You overhaul {label}." }
  }
}
