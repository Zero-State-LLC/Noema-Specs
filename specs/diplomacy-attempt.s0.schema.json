{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/diplomacy-attempt.s0.schema.json",
  "title": "NOEMA Diplomacy S0 attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "diplomacy-s0" },
    "catalog_id": { "const": "diplomacy-catalog/s0" },
    "operation": { "enum": ["AGREEMENT_FORM", "HELP_OMIT"] },
    "agreement_type": { "type": "string" },
    "party_count": { "type": "integer", "minimum": 0 },
    "topic": { "type": "string" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "reason": { "type": "string" },
        "listed": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
