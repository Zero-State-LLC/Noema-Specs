{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/social-memory-rebuild.gc3-s2.schema.json",
  "title": "NOEMA GC3-S2 public-band rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "events", "expected"],
  "properties": {
    "slice_id": { "const": "gc3-s2" },
    "catalog_id": { "const": "social-memory-catalog/gc3-s2" },
    "handles": { "type": "object", "additionalProperties": { "type": "string" } },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "cycle": { "type": "integer" },
          "sequence": { "type": "integer" },
          "payload": { "type": "object" }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["watch_lines"],
      "properties": {
        "watch_lines": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  }
}
