{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/world-state.schema.json",
  "title": "NOEMA World State (canonical replay snapshot fields)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "world-state/1.0"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "world_version": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable world ruleset/version identifier for this state."
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "description": "Current committed world cycle represented by this state."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Last committed ledger sequence represented by this state."
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "INCIDENT",
        "ARCHIVED"
      ]
    },
    "infrastructure": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "infra_type": {
            "enum": [
              "relay",
              "generator",
              "storage_bay",
              "production_node"
            ]
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "resource_nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "regen_per_cycle": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "active_agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room_id",
          "budgets"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "budgets": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "organizations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISSOLVED"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agent_id",
                "role"
              ],
              "properties": {
                "agent_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "entities_present": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "destroyed_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "last_event_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9]+:[A-Za-z0-9._-]+$",
      "description": "Digest of the last committed accepted world event, or null only at genesis before any accepted event."
    },
    "event_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of accepted world events represented by this state."
    },
    "catalog_version": {
      "enum": [
        "event-catalog/0.1",
        "event-catalog/0.2"
      ],
      "description": "Closed event catalog pin used for every accepted ledger event in this WorldState lineage."
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic canonical state revision. It MUST advance exactly with accepted atomic ledger commits and MUST NOT be reused for a different canonical state."
    },
    "canonicalization_version": {
      "const": "noema-jcs/1",
      "description": "Canonical JSON profile used for digest-bearing replay artifacts."
    },
    "hash_algorithm": {
      "const": "sha256",
      "description": "Hash algorithm used for state and ledger-head digest fields."
    }
  },
  "required": [
    "schema_version",
    "world_id",
    "cycle",
    "sequence",
    "active_agents",
    "organizations",
    "entities_present",
    "destroyed_entities",
    "event_count",
    "world_version",
    "status",
    "catalog_version",
    "state_revision",
    "canonicalization_version",
    "hash_algorithm",
    "last_event_digest"
  ],
  "description": "Canonical WorldState snapshot fields required for deterministic replay. Implementation metadata that is not part of the canonical digest-bearing state belongs outside this object or must be excluded by a versioned equivalence boundary.",
  "allOf": [
    {
      "if": {
        "required": [
          "event_count"
        ],
        "properties": {
          "event_count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "last_event_digest": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "event_count"
        ],
        "properties": {
          "event_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "then": {
        "properties": {
          "last_event_digest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+:[A-Za-z0-9._-]+$"
          }
        }
      }
    }
  ]
}
