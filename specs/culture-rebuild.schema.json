{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/culture-rebuild.schema.json",
  "title": "NOEMA GC9-S0 culture rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice_id",
    "catalog_id",
    "subject_id",
    "subject_entity_id",
    "events",
    "expected"
  ],
  "properties": {
    "slice_id": { "const": "gc9-s0" },
    "catalog_id": { "const": "culture-catalog/gc9-s0" },
    "subject_id": { "type": "string", "minLength": 1 },
    "subject_entity_id": { "type": "string", "minLength": 1 },
    "third_party_id": { "type": "string" },
    "lore_claim": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "cycle", "sequence", "payload"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "cycle": { "type": "integer", "minimum": 0 },
          "sequence": { "type": "integer", "minimum": 0 },
          "actor_id": { "type": ["string", "null"] },
          "payload": { "type": "object" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_lines",
        "watch_lines",
        "third_party_lines",
        "state",
        "ledger_mutated"
      ],
      "properties": {
        "play_lines": { "type": "array", "items": { "type": "string" } },
        "watch_lines": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "third_party_lines": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "state": { "enum": ["UNKNOWN", "PRACTICING", "CUSTOM"] },
        "ledger_mutated": { "const": false },
        "lore_wins": { "const": false },
        "note": { "type": "string" }
      }
    }
  }
}
