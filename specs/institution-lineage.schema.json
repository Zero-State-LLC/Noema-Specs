{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/institution-lineage.schema.json",
  "title": "NOEMA institution-lineage (v0.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "nodes",
    "edges",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "institution-lineage/0.6"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "institution_id",
          "status",
          "from_cycle"
        ],
        "properties": {
          "institution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "status": {
            "type": "string"
          },
          "from_cycle": {
            "type": "integer",
            "minimum": 0
          },
          "to_cycle": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_class": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation",
          "evidence_refs"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "relation": {
            "enum": [
              "EVOLVED_INTO",
              "SUCCEEDED_BY",
              "INSPIRED",
              "DISPUTED_WITH",
              "REVIVED_AS"
            ]
          },
          "at_cycle": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
