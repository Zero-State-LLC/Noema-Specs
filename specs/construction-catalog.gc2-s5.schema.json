{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-catalog.gc2-s5.schema.json",
  "title": "NOEMA Construction Catalog (GC2-S5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "help_build",
    "class_id",
    "operation",
    "storage_discount",
    "max_tier",
    "hidden_upgrade"
  ],
  "properties": {
    "schema_version": { "const": "construction-catalog/gc2-s5" },
    "catalog_id": { "const": "construction-catalog/gc2-s5" },
    "slice_id": { "const": "gc2-s5" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "construction-catalog/gc2-s4" },
    "verb": { "const": "BUILD" },
    "operation": { "const": "UPGRADE" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "event_catalog": { "const": "event-catalog/0.1" },
    "help_build": { "const": false },
    "watch_upgrade": { "const": false },
    "class_id": { "const": "workshop" },
    "upgrade_cost": { "type": "object" },
    "storage_discount": { "const": 2 },
    "max_tier": { "const": 1 },
    "hidden_upgrade": { "const": false }
  }
}
