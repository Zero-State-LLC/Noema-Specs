{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-attempt.gc5-s3.schema.json",
  "title": "NOEMA GC5-S3 board attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc5-s3" },
    "catalog_id": { "const": "communication-catalog/gc5-s3" },
    "operation": { "enum": ["BOARD"] },
    "room_hidden": { "type": "boolean" },
    "posted": { "type": "integer", "minimum": 0 },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "kept": { "type": "integer" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
