{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/equivalence-boundary.schema.json",
  "title": "NOEMA Equivalence Boundary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "boundary_version": {
      "const": "equivalence-boundary/v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "exact_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ignored_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ordered_collection_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unordered_collection_paths": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path", "identity"],
            "properties": {
              "path": { "type": "string" },
              "identity": { "type": "string" }
            }
          }
        ]
      }
    },
    "numeric_tolerances": {
      "type": "object"
    },
    "semantic_predicates": {
      "type": "array"
    },
    "observation_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cycle"],
        "properties": {
          "cycle": { "type": "integer", "minimum": 0 },
          "phase": { "type": "string" },
          "agent_id": { "type": "string" },
          "observation_id": { "type": "string" }
        }
      }
    },
    "divergence_policy": {
      "enum": ["stop-first", "collect-all"]
    },
    "claim_invalidation": {
      "type": "string",
      "minLength": 1
    },
    "required_comparisons": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "boundary_version",
    "exact_paths",
    "ignored_paths",
    "observation_points",
    "divergence_policy",
    "claim_invalidation"
  ]
}
