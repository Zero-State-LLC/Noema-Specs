{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/phenomenon-candidate.schema.json",
  "title": "NOEMA phenomenon-candidate (v0.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phenomenon_candidate_id",
    "source_lab_result_id",
    "source_candidate_ids",
    "source_experiment_ids",
    "behavior_definition",
    "observable_features",
    "required_outcome_boundary",
    "known_supporting_conditions",
    "known_counterconditions",
    "known_confounds",
    "generalization_boundary",
    "claim_label",
    "title",
    "provenance",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "phenomenon-candidate/0.5"
    },
    "phenomenon_candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source_lab_result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "source_experiment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "behavior_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "version",
        "predicates"
      ],
      "properties": {
        "definition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string"
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "observable_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "required_outcome_boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "known_supporting_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_counterconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_confounds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generalization_boundary": {
      "enum": [
        "EXACT_SCENARIO",
        "SCENARIO_FAMILY",
        "BEHAVIOR_FAMILY"
      ]
    },
    "claim_label": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "SPECULATIVE",
        "NOT_COMPUTABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
