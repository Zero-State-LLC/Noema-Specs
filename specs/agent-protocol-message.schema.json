{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/agent-protocol-message.schema.json",
  "title": "NOEMA Agent Protocol v1 Message Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "agent-protocol/v1"
    },
    "type": {
      "enum": [
        "HELLO",
        "AUTH",
        "REGISTER",
        "ENTER_WORLD",
        "OBSERVE",
        "ACT",
        "MESSAGE",
        "TOOL",
        "WAIT",
        "PING",
        "ERROR",
        "DISCONNECT",
        "HELLO_ACK",
        "AUTH_ACK",
        "REGISTER_ACK",
        "ENTER_WORLD_ACK",
        "ACT_RESULT",
        "MESSAGE_ACK",
        "PONG"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "agent_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "world_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "cycle": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" },
        "caused_by_request_id": { "type": "string" }
      },
      "required": ["code", "message", "retryable"]
    }
  },
  "required": ["protocol", "type", "request_id", "body"],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["ACT", "MESSAGE", "TOOL", "REGISTER", "ENTER_WORLD"]
          }
        }
      },
      "then": {
        "required": ["idempotency_key"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "ERROR" } }
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}
