{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/conflict-catalog.gc7-s2.schema.json",
  "title": "NOEMA Conflict Catalog (GC7-S2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "new_verbs",
    "new_events",
    "new_forms",
    "hp_combat",
    "org_as_declarer_id",
    "vacant_office_acts",
    "same_org_both_sides",
    "help_lists_contest",
    "resource_seizure_profile",
    "other_forms_profile",
    "payer"
  ],
  "properties": {
    "schema_version": { "const": "conflict-catalog/gc7-s2" },
    "catalog_id": { "const": "conflict-catalog/gc7-s2" },
    "slice_id": { "const": "gc7-s2" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.2" },
    "extends": { "const": "conflict-catalog/gc7-s1" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_forms": { "type": "array", "maxItems": 0 },
    "hp_combat": { "const": false },
    "character_death": { "const": false },
    "org_as_declarer_id": { "const": false },
    "vacant_office_acts": { "const": false },
    "same_org_both_sides": { "const": false },
    "help_lists_contest": { "const": false },
    "resource_seizure_profile": { "const": "OPERATE_RESOURCE_ACCOUNT" },
    "other_forms_profile": { "const": "OPERATE_NAMED_ASSET" },
    "payer": { "const": "treasury" }
  }
}
