{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/access-policy-catalog.s1.schema.json",
  "title": "NOEMA ACCESS_POLICY Catalog (S1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "verb",
    "scopes",
    "modes",
    "authority_profile",
    "acting_for_required",
    "new_verbs",
    "help_access_policy",
    "watch_ticker"
  ],
  "properties": {
    "schema_version": { "const": "access-policy-catalog/s1" },
    "catalog_id": { "const": "access-policy-catalog/s1" },
    "slice_id": { "const": "access-policy-s1" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.2" },
    "verb": { "const": "ACCESS_POLICY" },
    "scopes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "enum": ["EXIT", "ROOM"] }
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "enum": ["DENY", "CLEAR"] }
    },
    "authority_profile": { "const": "GRANT_ACCESS" },
    "acting_for_required": { "const": true },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "help_access_policy": { "const": false },
    "help_wed": { "const": false },
    "help_attest": { "const": false },
    "watch_ticker": { "const": false },
    "default_duration_cycles": { "type": "integer", "minimum": 1, "maximum": 8 }
  }
}
