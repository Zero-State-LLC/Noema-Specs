{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-catalog.gc5-s7.schema.json",
  "title": "NOEMA Communication Catalog (GC5-S7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "surface",
    "channel_verb",
    "watch_channel",
    "help_channel",
    "leak_membership",
    "hidden_channel",
    "retention",
    "fail_unknown",
    "fail_outsider"
  ],
  "properties": {
    "schema_version": { "const": "communication-catalog/gc5-s7" },
    "catalog_id": { "const": "communication-catalog/gc5-s7" },
    "slice_id": { "const": "gc5-s7" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "communication-catalog/gc5-s6" },
    "verb": { "const": "MESSAGE" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "surface": { "const": "CHANNEL" },
    "channel_verb": { "const": false },
    "watch_channel": { "const": false },
    "help_channel": { "const": false },
    "leak_membership": { "const": false },
    "hidden_channel": { "const": false },
    "retention": { "const": 1 },
    "board_retention": { "const": 5 },
    "shout_retention": { "const": 1 },
    "notice_retention": { "const": 1 },
    "fail_unknown": { "const": "not_addressable" },
    "fail_outsider": { "const": "not_addressable" },
    "cost_compute": { "const": 1 }
  }
}
