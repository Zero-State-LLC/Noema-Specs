{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/pressure-attempt.gc10-s2.schema.json",
  "title": "NOEMA GC10-S2 scar attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc10-s2" },
    "catalog_id": { "const": "pressure-catalog/gc10-s2" },
    "operation": { "enum": ["DISMANTLE", "REPAIR", "PRESSURE"] },
    "room_hidden": { "type": "boolean" },
    "scar": { "type": "boolean" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "leaves_scar": { "type": "boolean" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
