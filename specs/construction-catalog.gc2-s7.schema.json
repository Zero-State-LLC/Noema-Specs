{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-catalog.gc2-s7.schema.json",
  "title": "NOEMA Construction Catalog (GC2-S7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "help_build",
    "watch_abandon",
    "scar_on_abandon",
    "evict_player",
    "idle_cycles",
    "hidden_abandon"
  ],
  "properties": {
    "schema_version": { "const": "construction-catalog/gc2-s7" },
    "catalog_id": { "const": "construction-catalog/gc2-s7" },
    "slice_id": { "const": "gc2-s7" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "construction-catalog/gc2-s6" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "event_catalog": { "const": "event-catalog/0.1" },
    "help_build": { "const": false },
    "watch_abandon": { "const": false },
    "scar_on_abandon": { "const": false },
    "evict_player": { "const": false },
    "idle_cycles": { "const": 12 },
    "hidden_abandon": { "const": false }
  }
}
