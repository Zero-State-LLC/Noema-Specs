{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/experiment.schema.json",
  "title": "NOEMA experiment (v0.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_version",
    "experiment_design_version",
    "identity",
    "source_intent_id",
    "question",
    "hypothesis",
    "independent_variables",
    "dependent_measures",
    "controlled_variables",
    "interventions",
    "controls",
    "runs",
    "replication",
    "success_criteria",
    "failure_criteria",
    "stopping_rule",
    "analysis_rule",
    "equivalence_boundary",
    "confounds",
    "authorization",
    "consent_basis",
    "status",
    "provenance",
    "budgets",
    "input_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment/0.4"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "experiment_version": {
      "type": "string"
    },
    "experiment_design_version": {
      "const": "experiment-design/0.4"
    },
    "identity": {
      "type": "object",
      "additionalProperties": true
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": true
    },
    "source_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "independent_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "dependent_measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "controlled_variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": true
    },
    "success_criteria": {
      "type": "object",
      "additionalProperties": true
    },
    "failure_criteria": {
      "type": "object",
      "additionalProperties": true
    },
    "stopping_rule": {
      "type": "object",
      "additionalProperties": true
    },
    "analysis_rule": {
      "type": "object",
      "additionalProperties": true
    },
    "equivalence_boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "confounds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": true
    },
    "consent_basis": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATED",
        "READY",
        "RUNNING",
        "COMPLETE",
        "INVALID",
        "ABORTED",
        "PARTIAL",
        "NOT_COMPUTABLE",
        "QUARANTINED"
      ]
    },
    "interpretation": {
      "enum": [
        "SUPPORTED",
        "PARTIALLY_SUPPORTED",
        "NOT_SUPPORTED",
        "INCONCLUSIVE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "budgets": {
      "type": "object",
      "additionalProperties": true
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "supersedes_experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source_intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
