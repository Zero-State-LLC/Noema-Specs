{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/discovery-rebuild.schema.json",
  "title": "NOEMA GC6-S0 discovery rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice_id",
    "catalog_id",
    "subject_id",
    "archive",
    "inspect",
    "expected"
  ],
  "properties": {
    "slice_id": { "const": "gc6-s0" },
    "catalog_id": { "const": "discovery-catalog/gc6-s0" },
    "subject_id": { "type": "string", "minLength": 1 },
    "third_party_id": { "type": "string" },
    "archive": { "$ref": "#/$defs/archive_member" },
    "inspect": { "$ref": "#/$defs/inspect_member" },
    "known_truth_relationship": {
      "type": "object",
      "additionalProperties": true,
      "description": "Research partition only. Must not appear in expected PLAY."
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_lines",
        "watch_lines",
        "third_party_lines",
        "discovery_state",
        "resolution_status",
        "quest_log"
      ],
      "properties": {
        "play_lines": { "type": "array", "items": { "type": "string" } },
        "watch_lines": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "third_party_lines": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "discovery_state": {
          "enum": ["unknown", "discovered", "observed", "investigated", "understood"]
        },
        "resolution_status": { "enum": ["none", "open"] },
        "quest_log": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "archive_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "subject_entity_id", "claim", "accessible_to"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "subject_entity_id": { "type": "string", "minLength": 1 },
        "claim": { "enum": ["DESTROYED", "OPERATING"] },
        "accessible_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inspect_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "subject_entity_id", "observation", "accessible_to"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "subject_entity_id": { "type": "string", "minLength": 1 },
        "observation": { "enum": ["DESTROYED", "OPERATING"] },
        "accessible_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
