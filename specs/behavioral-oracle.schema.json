{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/behavioral-oracle.schema.json",
  "title": "NOEMA behavioral-oracle (v0.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_id",
    "oracle_version",
    "target_behavior",
    "equivalence_boundary",
    "observation_points",
    "required_predicates",
    "metric_refs",
    "feature_refs",
    "allowed_tolerances",
    "replication_plan",
    "missing_data_behavior",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "behavioral-oracle/0.5"
    },
    "oracle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "oracle_version": {
      "type": "string"
    },
    "target_behavior": {
      "type": "object",
      "additionalProperties": true
    },
    "equivalence_boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "observation_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "metric_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tolerances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "replication_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_count",
        "success_threshold",
        "seed_policy",
        "stopping_rule"
      ],
      "properties": {
        "run_count": {
          "type": "integer",
          "minimum": 1
        },
        "success_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "seed_policy": {
          "type": "string"
        },
        "stopping_rule": {
          "type": "string"
        },
        "recorded_provider_responses": {
          "type": "boolean"
        }
      }
    },
    "missing_data_behavior": {
      "enum": [
        "INVALID",
        "INCONCLUSIVE"
      ]
    },
    "cache_identity_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
