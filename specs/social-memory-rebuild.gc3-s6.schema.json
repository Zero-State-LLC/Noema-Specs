{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/social-memory-rebuild.gc3-s6.schema.json",
  "title": "NOEMA GC3-S6 deceptive rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "subject_id", "events", "expected"],
  "properties": {
    "slice_id": { "const": "gc3-s6" },
    "catalog_id": { "const": "social-memory-catalog/gc3-s6" },
    "subject_id": { "type": "string" },
    "handles": { "type": "object", "additionalProperties": { "type": "string" } },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "cycle": { "type": "integer" },
          "sequence": { "type": "integer" },
          "payload": { "type": "object" }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["deceptive", "play_lines", "watch_lines"],
      "properties": {
        "deceptive": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["count"],
            "properties": { "count": { "type": "integer", "minimum": 0 } }
          }
        },
        "play_lines": { "type": "array", "items": { "type": "string" } },
        "watch_lines": { "type": "array", "maxItems": 0 },
        "note": { "type": "string" }
      }
    }
  }
}
