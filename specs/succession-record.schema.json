{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/succession-record.schema.json",
  "title": "NOEMA succession-record (v0.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "succession_id",
    "subject_type",
    "subject_ref",
    "role_id",
    "mechanism",
    "from_holder",
    "to_holder",
    "cycle",
    "outcome",
    "evidence_refs",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "succession-record/0.6"
    },
    "succession_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "subject_type": {
      "enum": [
        "ORGANIZATION_LEADERSHIP",
        "INSTITUTION_CUSTODIANSHIP",
        "ARTIFACT_STEWARDSHIP",
        "INFRASTRUCTURE_CONTROL",
        "FORMAL_ROLE"
      ]
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "mechanism": {
      "enum": [
        "DESIGNATED",
        "RULE_BASED",
        "CONSENSUS",
        "VACANT",
        "INHERITED_BY_ORGANIZATION"
      ]
    },
    "from_holder": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "to_holder": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "TRANSFERRED",
        "VACANT",
        "FAILED",
        "BLOCKED"
      ]
    },
    "designation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "institution_continues": {
      "type": "boolean"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
