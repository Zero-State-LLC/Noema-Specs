{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-catalog.gc5-s8.schema.json",
  "title": "NOEMA Communication Catalog (GC5-S8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "surface",
    "market_verb",
    "auto_trade",
    "price_oracle",
    "long_range_stall",
    "hidden_stall",
    "watch_stall",
    "help_stall",
    "retention"
  ],
  "properties": {
    "schema_version": { "const": "communication-catalog/gc5-s8" },
    "catalog_id": { "const": "communication-catalog/gc5-s8" },
    "slice_id": { "const": "gc5-s8" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "communication-catalog/gc5-s7" },
    "verb": { "const": "MESSAGE" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "surface": { "const": "TRADE_NOTICE" },
    "market_verb": { "const": false },
    "auto_trade": { "const": false },
    "price_oracle": { "const": false },
    "long_range_stall": { "const": false },
    "hidden_stall": { "const": false },
    "watch_stall": { "const": false },
    "help_stall": { "const": false },
    "retention": { "const": 1 },
    "board_retention": { "const": 5 },
    "shout_retention": { "const": 1 },
    "notice_retention": { "const": 1 },
    "channel_retention": { "const": 1 },
    "cost_compute": { "const": 1 }
  }
}
