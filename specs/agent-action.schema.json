{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/agent-action.schema.json",
  "title": "NOEMA Agent Action",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-action/1.0"
    },
    "action_id": {
      "type": "string",
      "pattern": "^act\\.[A-Za-z0-9_.-]+$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agent\\.[A-Za-z0-9_.-]+$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^(world\\.[A-Za-z0-9_-]+|world-[0-9]+)$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "verb": {
      "enum": [
        "LOOK",
        "MOVE",
        "INSPECT",
        "ASK",
        "MESSAGE",
        "QUERY",
        "TRADE",
        "BUILD",
        "RESEARCH",
        "DELEGATE",
        "COMMIT",
        "EXPERIMENT",
        "MODEL",
        "WAIT"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "client_action_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per (world_id, agent_id, session_epoch); canonical cycle ordering input."
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "agent_id",
    "world_id",
    "cycle",
    "client_action_sequence",
    "verb",
    "parameters",
    "idempotency_key"
  ]
}
