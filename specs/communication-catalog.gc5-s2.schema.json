{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/communication-catalog.gc5-s2.schema.json",
  "title": "NOEMA Communication Catalog (GC5-S2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "event_catalog",
    "extends",
    "verb",
    "success_events",
    "new_verbs",
    "new_events",
    "rumor_enabled",
    "rumor_is_claim",
    "rumor_score",
    "truth_probability",
    "spread_rumor_verb",
    "llm_similarity",
    "omniscient_resolver",
    "delay_enabled",
    "watch_text",
    "copies_are_independent",
    "valid_origins",
    "forbidden_origins",
    "epistemic_labels"
  ],
  "properties": {
    "schema_version": { "const": "communication-catalog/gc5-s2" },
    "catalog_id": { "const": "communication-catalog/gc5-s2" },
    "slice_id": { "const": "gc5-s2" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "event_catalog": { "const": "event-catalog/0.1" },
    "extends": { "const": "communication-catalog/gc5-s1" },
    "verb": { "const": "MESSAGE" },
    "success_events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "const": "MESSAGE" }, { "const": "MESSAGE_DELIVERED" }],
      "items": false
    },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "surfaces": { "type": "array", "items": { "type": "string" } },
    "rumor_enabled": { "const": true },
    "rumor_is_claim": { "const": true },
    "rumor_score": { "const": false },
    "truth_probability": { "const": false },
    "spread_rumor_verb": { "const": false },
    "llm_similarity": { "const": false },
    "omniscient_resolver": { "const": false },
    "delay_enabled": { "const": true },
    "delay_cycles": { "const": 1 },
    "long_range_min_condition": { "const": 25 },
    "same_cycle_min_condition": { "const": 50 },
    "long_range_failure": { "const": "UNREACHABLE" },
    "watch_text": { "const": false },
    "watch_projection": { "const": true },
    "watch_oracle": { "const": false },
    "stale_after_cycles": { "const": 8 },
    "material_change": { "const": "new_derived_claim" },
    "copies_are_independent": { "const": false },
    "valid_origins": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_origins": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "epistemic_labels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "watch_report_pulse": { "type": "string" },
    "watch_conflict_pulse": { "type": "string" },
    "forbidden_in_projection": { "type": "array", "items": { "type": "string" } }
  }
}
