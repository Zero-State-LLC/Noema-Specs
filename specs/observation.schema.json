{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/observation.schema.json",
  "title": "NOEMA Observation",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "claim_label": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "SPECULATIVE",
        "NOT_COMPUTABLE"
      ]
    },
    "structured_value": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "localized_fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/identifier"
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/structured_value"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_label": {
          "$ref": "#/$defs/claim_label"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "predicate",
        "value"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "object"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localized_fact"
          }
        },
        "affordances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "claim_label": {
          "$ref": "#/$defs/claim_label"
        }
      },
      "required": [
        "entity_id",
        "entity_type"
      ]
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "traversable": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_label": {
          "$ref": "#/$defs/claim_label"
        }
      },
      "required": [
        "exit_id",
        "label",
        "traversable"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "$ref": "#/$defs/identifier"
        },
        "channel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sent_cycle": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structured_value"
          }
        }
      },
      "required": [
        "message_id",
        "text"
      ]
    },
    "budget_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attention_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "compute_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "actions_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "messages_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "reset_cycle": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_id": {
          "$ref": "#/$defs/identifier"
        },
        "organization_id": {
          "$ref": "#/$defs/identifier"
        },
        "institution_id": {
          "$ref": "#/$defs/identifier"
        },
        "market_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "room_projection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "room_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "local_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "room_id"
      ]
    },
    "projection_object": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "claim_label": {
          "$ref": "#/$defs/claim_label"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ]
    },
    "budget_state": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "remaining": {
            "type": "number",
            "minimum": 0
          },
          "limit": {
            "type": "number",
            "minimum": 0
          },
          "reset_cycle": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "observation/1.0"
    },
    "observation_id": {
      "$ref": "#/$defs/identifier"
    },
    "world_id": {
      "$ref": "#/$defs/identifier"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "observer_id": {
      "$ref": "#/$defs/identifier"
    },
    "source": {
      "type": "string"
    },
    "claim_label": {
      "$ref": "#/$defs/claim_label"
    },
    "content": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "room": {
          "$ref": "#/$defs/room_projection"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_object"
          }
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_object"
          }
        },
        "organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_object"
          }
        },
        "institutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_object"
          }
        },
        "markets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_object"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structured_value"
          }
        },
        "budget_state": {
          "$ref": "#/$defs/budget_state"
        },
        "redactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/redaction"
          }
        },
        "observation_type": {
          "enum": [
            "WORLD_VIEW",
            "LOCATION_VIEW",
            "ENTITY_INSPECTION",
            "MESSAGE_DELIVERY",
            "ACTION_RESULT",
            "TOOL_RESULT",
            "SYSTEM_NOTICE",
            "MIXED"
          ]
        },
        "summary": {
          "type": "string"
        },
        "location": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "location_id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "region_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "properties": {
              "type": "object"
            }
          },
          "required": [
            "location_id"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exit"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localized_fact"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "#/$defs/identifier"
              },
              "event_type": {
                "type": "string",
                "minLength": 1
              },
              "occurred_cycle": {
                "type": "integer",
                "minimum": 0
              },
              "description": {
                "type": "string"
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "data": {
                "type": "object"
              },
              "claim_label": {
                "$ref": "#/$defs/claim_label"
              }
            },
            "required": [
              "event_type"
            ]
          }
        },
        "action_result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "$ref": "#/$defs/identifier"
            },
            "status": {
              "enum": [
                "ACCEPTED",
                "SUCCEEDED",
                "COMMITTED",
                "FAILED",
                "REJECTED",
                "PARTIAL"
              ]
            },
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/localized_fact"
              }
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "resulting_event_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            },
            "visible_state_delta": {
              "type": "object"
            },
            "reservations_consumed": {
              "type": "object"
            },
            "reservations_released": {
              "type": "object"
            }
          },
          "required": [
            "action_id",
            "status"
          ]
        },
        "affordances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verb": {
                "type": "string",
                "minLength": 1
              },
              "target_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parameters": {
                "type": "object"
              },
              "available": {
                "type": "boolean"
              },
              "unavailable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "verb",
              "available"
            ]
          }
        },
        "budgets": {
          "$ref": "#/$defs/budget_snapshot"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "INFO",
                  "WARNING",
                  "ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "severity",
              "message"
            ]
          }
        },
        "state_delta": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknown_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/structured_value"
                },
                "minItems": 2
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "field",
              "alternatives"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "NONE",
            "BOUNDED",
            "DISTRIBUTIONAL",
            "CONFLICTING",
            "DELAYED",
            "NOT_COMPUTABLE"
          ]
        },
        "fields": {
          "type": "object"
        },
        "confidence_interval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structured_value"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "world_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "world_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reducer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reducer_id": {
              "$ref": "#/$defs/identifier"
            },
            "reducer_version": {
              "type": "string",
              "minLength": 1
            },
            "input_digest": {
              "type": "string",
              "minLength": 1
            },
            "output_digest": {
              "type": "string",
              "minLength": 1
            },
            "budget_limit": {
              "type": "integer",
              "minimum": 0
            },
            "budget_used": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "omitted_sections": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "reducer_id",
            "reducer_version"
          ]
        },
        "visibility": {
          "enum": [
            "PRIVATE",
            "WORLD",
            "RESEARCH_RESTRICTED",
            "PUBLIC"
          ]
        },
        "consent_basis": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "source_state_revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "generated_cycle": {
          "type": "integer",
          "minimum": 0
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "visibility_policy_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "noise_policy_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "attention_cost": {
          "type": "number",
          "minimum": 0
        },
        "salience_rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed_stream": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_eligible": {
          "type": "boolean"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "available_services": {
      "type": "array",
      "items": {
        "$ref": "world-service-capability.schema.json"
      },
      "description": "World Services visible in current context. See WORLD-SERVICES-AGENT-CONTRACT.md"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "world_id",
    "cycle",
    "observer_id",
    "source",
    "claim_label",
    "content",
    "provenance"
  ],
  "description": " World Services appear via optional \"available_services\" array using world-service-capability.schema.json (see WORLD-SERVICES-AGENT-CONTRACT.md). This is an extension point for agent observations."
}