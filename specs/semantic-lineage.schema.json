{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/semantic-lineage.schema.json",
  "title": "NOEMA semantic-lineage (v0.6 foundation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "subject_kind",
    "canonical_subject_id",
    "entries",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-lineage/0.6"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "subject_kind": {
      "enum": [
        "TERM",
        "SYMBOL",
        "PRACTICE",
        "NAME",
        "WARNING",
        "STORY",
        "CUSTOM"
      ]
    },
    "canonical_subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "cycle",
          "surface_form",
          "meaning_note",
          "source_refs"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          },
          "surface_form": {
            "type": "string"
          },
          "meaning_note": {
            "type": "string"
          },
          "changed_from_previous": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_label": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "SPECULATIVE",
              "NOT_COMPUTABLE"
            ]
          }
        }
      }
    },
    "auto_interpreted": {
      "const": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
