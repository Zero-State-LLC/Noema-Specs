{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/social-memory-rebuild.gc3-s4.schema.json",
  "title": "NOEMA GC3-S4 decay/rehab rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "subject_id", "as_of_cycle", "events", "expected"],
  "properties": {
    "slice_id": { "const": "gc3-s4" },
    "catalog_id": { "const": "social-memory-catalog/gc3-s4" },
    "subject_id": { "type": "string" },
    "as_of_cycle": { "type": "integer", "minimum": 0 },
    "handles": { "type": "object", "additionalProperties": { "type": "string" } },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "cycle": { "type": "integer" },
          "sequence": { "type": "integer" },
          "payload": { "type": "object" }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["play_lines"],
      "properties": {
        "play_lines": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  }
}
