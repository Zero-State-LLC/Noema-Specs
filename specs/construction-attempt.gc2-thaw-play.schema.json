{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-thaw-play.schema.json",
  "title": "NOEMA GC2 PLAY thaw attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-thaw-play" },
    "catalog_id": { "const": "construction-catalog/gc2-thaw-play" },
    "operation": { "enum": ["HELP_BUILD", "HELP_OMIT"] },
    "topic": { "type": "string" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "listed": { "type": "boolean" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
