{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/1.0/common.schema.json",
  "title": "Noema common definitions",
  "type": "object",
  "$defs": {
    "protocolId": {"const": "noema.core"},
    "protocolVersion": {"const": "1.0.0"},
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"},
    "operationName": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "jsonScalar": {"type": ["string", "number", "boolean", "null"]},
    "metadata": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/jsonScalar"}},
    "envelope": {
      "type": "object",
      "properties": {
        "protocol_id": {"$ref": "#/$defs/protocolId"}, "protocol_version": {"$ref": "#/$defs/protocolVersion"},
        "message_id": {"$ref": "#/$defs/uuid"}, "message_type": {"enum": ["command", "event", "replay_request"]},
        "occurred_at": {"$ref": "#/$defs/timestamp"}, "tenant_id": {"$ref": "#/$defs/identifier"},
        "stream_id": {"$ref": "#/$defs/identifier"}, "correlation_id": {"$ref": "#/$defs/uuid"},
        "causation_id": {"$ref": "#/$defs/uuid"}, "metadata": {"$ref": "#/$defs/metadata"}
      },
      "required": ["protocol_id", "protocol_version", "message_id", "message_type", "occurred_at", "tenant_id", "stream_id", "correlation_id", "metadata"]
    }
  }
}
