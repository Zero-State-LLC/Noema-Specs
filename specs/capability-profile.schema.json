{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/capability-profile.schema.json",
  "title": "NOEMA Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "capability-profile/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^([A-Z_]+|UNKNOWN_CAPABILITY_[A-Za-z0-9_-]+)$"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "first_observed": {
      "type": "string"
    },
    "replication_count": {
      "type": "integer",
      "minimum": 0
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transfer_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_version": {
      "type": "string"
    },
    "world_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "label",
    "description",
    "evidence",
    "first_observed",
    "replication_count",
    "attempt_count",
    "confidence",
    "transfer_domains",
    "dependencies",
    "failure_boundaries",
    "agent_version",
    "world_version",
    "protocol_version"
  ]
}
