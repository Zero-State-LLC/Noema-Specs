{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s4.schema.json",
  "title": "NOEMA GC2-S4 archive_annex attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s4" },
    "catalog_id": { "const": "construction-catalog/gc2-s4" },
    "operation": { "enum": ["CONSTRUCT", "INSPECT", "ATTEST"] },
    "class_id": { "type": "string" },
    "room_hidden": { "type": "boolean" },
    "has_annex": { "type": "boolean" },
    "base_attention": { "type": "integer", "minimum": 0 },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "attention_cost": { "type": "integer" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
