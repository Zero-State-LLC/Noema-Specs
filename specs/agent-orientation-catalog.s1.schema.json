{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/agent-orientation-catalog.s1.schema.json",
  "title": "NOEMA Agent Orientation Catalog (S1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "new_events",
    "arrival_speech",
    "invent_strain",
    "thesis_forbidden",
    "situation_fields",
    "max_available_actions"
  ],
  "properties": {
    "schema_version": { "const": "agent-orientation-catalog/s1" },
    "catalog_id": { "const": "agent-orientation-catalog/s1" },
    "slice_id": { "const": "agent-orientation-s1" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "extends": { "const": "agent-orientation-catalog/s0" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "arrival_speech": { "const": false },
    "invent_strain": { "const": false },
    "thesis_forbidden": { "const": true },
    "situation_fields": { "const": true },
    "max_available_actions": { "const": 8 }
  }
}
