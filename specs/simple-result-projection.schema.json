{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/simple-result-projection.schema.json",
  "title": "NOEMA Simple STUDY Result Projection (v0.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "lab_result_id", "experiment_id", "source_intent_id", "question", "interpretation", "claim_label", "compiler_readiness", "result", "evidence", "limitations", "advanced_detail_ref", "allowed_actions", "digest"],
  "properties": {
    "schema_version": {"const": "simple-result-projection/0.4"},
    "projection_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "lab_result_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "source_intent_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "question": {"type": "string", "minLength": 1},
    "interpretation": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE"]},
    "claim_label": {"enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]},
    "compiler_readiness": {"enum": ["READY", "NOT_READY", "REJECTED"]},
    "result": {"type": "object", "additionalProperties": false, "required": ["outcome_class", "simple_statement", "within_tested_conditions"], "properties": {"outcome_class": {"enum": ["PERSISTED", "DEGRADED", "DISAPPEARED", "CHANGED_FORM", "NOT_COMPARABLE", "NOT_COMPUTABLE"]}, "simple_statement": {"type": "string", "minLength": 1}, "within_tested_conditions": {"type": "boolean"}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "advanced_detail_ref": {"type": "string", "minLength": 1},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["TEST_ANOTHER_VERSION", "TEST_ANOTHER_SITUATION", "RESOLVE_CONFOUND", "REVIEW_REJECTION", "CAPTURE_AS_TEST"]}},
    "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"compiler_readiness": {"const": "READY"}}}, "then": {"properties": {"allowed_actions": {"contains": {"const": "CAPTURE_AS_TEST"}}}}, "else": {"properties": {"allowed_actions": {"not": {"contains": {"const": "CAPTURE_AS_TEST"}}}}}}
  ]
}
