{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/succession-attempt.gc4-s7.schema.json",
  "title": "NOEMA GC4-S7 inherited-org attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc4-s7" },
    "catalog_id": { "const": "authority-catalog/gc4-s7" },
    "operation": { "enum": ["PUBLISH", "VACATE"] },
    "rule_id": { "type": "string" },
    "published": { "type": "boolean" },
    "eligible_remaining": { "type": "integer", "minimum": 0 },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "seated": { "type": "boolean" },
        "retired": { "type": "boolean" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
