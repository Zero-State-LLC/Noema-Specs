{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s12.schema.json",
  "title": "NOEMA GC2-S12 CONNECT dest attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s12" },
    "catalog_id": { "const": "construction-catalog/gc2-s12" },
    "operation": { "enum": ["CONNECT"] },
    "room_hidden": { "type": "boolean" },
    "dest_hidden": { "type": "boolean" },
    "public_pair": { "type": "boolean" },
    "steward": { "type": "boolean" },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "same_entity": { "type": "boolean" },
        "new_exit": { "type": "boolean" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
