{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/agent-harness-catalog.s0.schema.json",
  "title": "NOEMA Headless Agent Harness Catalog (S0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "new_verbs",
    "new_events",
    "new_player_classes",
    "browser_canonical",
    "token_in_model_context",
    "chain_of_thought_required",
    "harness_is_world_authority",
    "provider_neutral",
    "affordance_first",
    "server_final_authority",
    "pacing_default",
    "circuit_breaker_required",
    "prompt_injection_boundary",
    "player_parity"
  ],
  "properties": {
    "schema_version": { "const": "agent-harness-catalog/s0" },
    "catalog_id": { "const": "agent-harness-catalog/s0" },
    "slice_id": { "const": "agent-harness-s0" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_player_classes": { "type": "array", "maxItems": 0 },
    "browser_canonical": { "const": false },
    "token_in_model_context": { "const": false },
    "chain_of_thought_required": { "const": false },
    "harness_is_world_authority": { "const": false },
    "provider_neutral": { "const": true },
    "affordance_first": { "const": true },
    "server_final_authority": { "const": true },
    "pacing_default": { "const": "TURN" },
    "circuit_breaker_required": { "const": true },
    "prompt_injection_boundary": { "const": true },
    "player_parity": { "const": true }
  }
}
