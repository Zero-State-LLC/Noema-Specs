{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/behavior-node.schema.json",
  "title": "NOEMA behavior-node (v0.7 LEARN)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "behavior_id",
    "title",
    "description",
    "behavioral_signature_ref",
    "source_captured_test_ids",
    "claim_label",
    "known_limits",
    "provenance",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "behavior-node/0.7"
    },
    "behavior_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "behavioral_signature_ref": {
      "type": "string"
    },
    "source_captured_test_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "source_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "claim_label": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "SPECULATIVE",
        "NOT_COMPUTABLE"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED"
      ]
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
