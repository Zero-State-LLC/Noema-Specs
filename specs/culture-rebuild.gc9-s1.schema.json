{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/culture-rebuild.gc9-s1.schema.json",
  "title": "NOEMA GC9-S1 tradition rebuild fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "subject_id", "subject_entity_id", "world_cycle", "events", "expected"],
  "properties": {
    "slice_id": { "const": "gc9-s1" },
    "catalog_id": { "const": "culture-catalog/gc9-s1" },
    "subject_id": { "type": "string", "minLength": 1 },
    "subject_entity_id": { "type": "string", "minLength": 1 },
    "third_party_id": { "type": "string" },
    "world_cycle": { "type": "integer", "minimum": 0 },
    "institutional_member": { "type": "boolean" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "cycle": { "type": "integer" },
          "sequence": { "type": "integer" },
          "actor_id": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    },
    "reconstructions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reconstruction_id", "visibility", "subject_ref"],
        "properties": {
          "reconstruction_id": { "type": "string" },
          "visibility": { "enum": ["PRIVATE", "INSTITUTIONAL", "PUBLIC"] },
          "subject_ref": { "type": "string" },
          "claim": { "type": "string" },
          "epistemic": { "enum": ["OPEN", "CONTESTED"] },
          "author_id": { "type": "string" }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["play_lines", "state"],
      "properties": {
        "play_lines": { "type": "array", "items": { "type": "string" } },
        "watch_lines": { "type": "array", "items": { "type": "string" } },
        "third_party_lines": { "type": "array", "items": { "type": "string" } },
        "state": {
          "enum": ["UNKNOWN", "PRACTICING", "CUSTOM", "TRADITION", "DORMANT", "REVIVED"]
        },
        "ledger_mutated": { "const": false },
        "bonus": { "const": false },
        "note": { "type": "string" }
      }
    }
  }
}
