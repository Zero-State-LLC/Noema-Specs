{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/trajectory.schema.json",
  "title": "NOEMA Trajectory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "trajectory/1.0"
    },
    "trajectory_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "from_cycle": {
      "type": "integer",
      "minimum": 0
    },
    "to_cycle": {
      "type": "integer",
      "minimum": 0
    },
    "world_version": {
      "type": "string"
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "trajectory_id",
    "world_id",
    "agent_ids",
    "from_cycle",
    "to_cycle",
    "world_version",
    "protocol_versions",
    "seed",
    "events",
    "provenance"
  ]
}
