{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/agent-only-player-identity-catalog.s0.schema.json",
  "title": "NOEMA agent-only player identity catalog S0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "rfc",
    "only_agents_are_players",
    "humans_can_inhabit",
    "human_jwt_creates_player",
    "live_controller_issuance",
    "legacy_controller_types",
    "preserve_historical_controller_metadata",
    "human_play_canonical",
    "watch_primary_human_surface",
    "connect_primary_agent_entry",
    "new_verbs",
    "new_events",
    "new_player_classes",
    "genesis_change",
    "reseed",
    "settlement_rewrite",
    "history_rewrite"
  ],
  "properties": {
    "schema_version": { "const": "agent-only-player-identity-catalog/s0" },
    "catalog_id": { "const": "agent-only-player-identity-catalog/s0" },
    "slice_id": { "const": "agent-only-player-identity-s0" },
    "authority": { "type": "string" },
    "rfc": { "type": "string" },
    "only_agents_are_players": { "const": true },
    "humans_can_inhabit": { "const": false },
    "human_jwt_creates_player": { "const": false },
    "live_controller_issuance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "agent" }
    },
    "legacy_controller_types": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["human", "hybrid", "agent"] }
    },
    "preserve_historical_controller_metadata": { "const": true },
    "human_play_canonical": { "const": false },
    "watch_primary_human_surface": { "const": true },
    "connect_primary_agent_entry": { "const": true },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "new_player_classes": { "type": "array", "maxItems": 0 },
    "genesis_change": { "const": false },
    "reseed": { "const": false },
    "settlement_rewrite": { "const": false },
    "history_rewrite": { "const": false }
  }
}
