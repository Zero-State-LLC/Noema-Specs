{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/culture-catalog.gc9-s1.schema.json",
  "title": "NOEMA Culture Catalog (GC9-S1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "slice_id",
    "authority",
    "custom_threshold",
    "tradition_min_cycles",
    "tradition_min_accessors",
    "dormant_gap_cycles",
    "tradition_line",
    "new_verbs",
    "new_events",
    "ledger_write",
    "lore_overrides_ledger",
    "gameplay_bonus",
    "culture_score",
    "auto_promote_custom",
    "watch_oracle",
    "forbidden_in_projection"
  ],
  "properties": {
    "schema_version": { "const": "culture-catalog/gc9-s1" },
    "catalog_id": { "const": "culture-catalog/gc9-s1" },
    "slice_id": { "const": "gc9-s1" },
    "authority": { "type": "string", "minLength": 1 },
    "rfc": { "type": "string" },
    "lineage_schema": { "type": "string" },
    "extends": { "const": "culture-catalog/gc9-s0" },
    "custom_threshold": { "const": 3 },
    "tradition_min_cycles": { "type": "integer", "minimum": 2 },
    "tradition_min_accessors": { "type": "integer", "minimum": 2 },
    "tradition_min_public_recons": { "type": "integer", "minimum": 2 },
    "dormant_gap_cycles": { "type": "integer", "minimum": 2 },
    "custom_line": { "type": "string" },
    "tradition_line": { "type": "string", "minLength": 1 },
    "dormant_line": { "type": "string" },
    "revived_line": { "type": "string" },
    "competing_line": { "type": "string" },
    "watch_tradition_pulse": { "type": "string" },
    "watch_contested_pulse": { "type": "string" },
    "new_verbs": { "type": "array", "maxItems": 0 },
    "new_events": { "type": "array", "maxItems": 0 },
    "ledger_write": { "const": false },
    "lore_overrides_ledger": { "const": false },
    "gameplay_bonus": { "const": false },
    "culture_score": { "const": false },
    "v06c": { "const": false },
    "procedural_generator": { "const": false },
    "auto_promote_custom": { "const": false },
    "watch_projection": { "type": "boolean" },
    "watch_oracle": { "const": false },
    "forbidden_in_projection": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
