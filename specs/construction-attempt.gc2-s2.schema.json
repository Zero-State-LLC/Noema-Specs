{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/construction-attempt.gc2-s2.schema.json",
  "title": "NOEMA GC2-S2 workshop attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "catalog_id", "operation", "expected"],
  "properties": {
    "slice_id": { "const": "gc2-s2" },
    "catalog_id": { "const": "construction-catalog/gc2-s2" },
    "operation": { "enum": ["CONSTRUCT", "REPAIR"] },
    "class_id": { "type": "string" },
    "room_hidden": { "type": "boolean" },
    "has_workshop": { "type": "boolean" },
    "base_storage": { "type": "integer", "minimum": 0 },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ACCEPT", "REJECT"] },
        "storage_cost": { "type": "integer" },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
