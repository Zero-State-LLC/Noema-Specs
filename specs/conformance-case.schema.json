{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.noema.dev/conformance-case.schema.json",
  "title": "NOEMA Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "conformance-case/1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 17
      },
      "uniqueItems": true
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fixtures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "actor", "action", "input"],
        "properties": {
          "step_id": { "type": "string" },
          "actor": {
            "enum": ["client", "server", "world-engine", "operator", "observatory"]
          },
          "action": { "type": "string" },
          "input": {},
          "notes": { "type": "string" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "EQUIVALENT",
            "DIVERGENT",
            "NO_LEAK",
            "NO_MUTATION",
            "DENY"
          ]
        },
        "error_code": { "type": "string" },
        "assertions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "must_not_contain_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "security_class": {
      "enum": ["none", "authz", "privacy", "sandbox", "consent"]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "suite",
    "title",
    "acceptance_items",
    "requirement_refs",
    "steps",
    "expected"
  ]
}
