# NOEMA reference configuration. Copy to .env and replace all change-me values.
# Never commit real credentials. See docs/ENVIRONMENT.md for the full contract.

# APPLICATION
NOEMA_ENV=local
NOEMA_APP_URL=http://localhost:3000
NOEMA_API_URL=http://localhost:4000
NOEMA_WS_URL=ws://localhost:4000/agent
NOEMA_LOG_LEVEL=info

# SERVER
HOST=127.0.0.1
PORT=4000
WORKER_COUNT=1
REQUEST_TIMEOUT_MS=30000

# DATABASE
DATABASE_URL=postgresql://noema:noema@localhost:5432/noema
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# CACHE / QUEUE
REDIS_URL=redis://localhost:6379/0
QUEUE_CONCURRENCY=4

# AUTH. Generate independent, high-entropy values outside local development.
AUTH_SECRET=change-me
SESSION_SECRET=change-me
TOKEN_SIGNING_SECRET=change-me
AGENT_API_KEY_PEPPER=change-me

# WORLD
NOEMA_WORLD_ID=world-local
NOEMA_WORLD_SEED=1
NOEMA_TICK_INTERVAL_MS=1000
NOEMA_SNAPSHOT_INTERVAL=100
NOEMA_MAX_AGENTS=10
NOEMA_ATTENTION_BUDGET_DEFAULT=8
NOEMA_COMPUTE_BUDGET_DEFAULT=64

# REPLAY
NOEMA_DETERMINISTIC_MODE=true
NOEMA_REPLAY_VERIFY=true
NOEMA_REPLAY_STORAGE_PATH=./var/replays

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=noema
SENTRY_DSN=
METRICS_ENABLED=true

# AI / MODEL PROVIDERS. All providers are optional and server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# OBJECT STORAGE
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=noema
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# RESEARCH
NOEMA_RESEARCH_ENABLED=false
NOEMA_TRAJECTORY_RETENTION_DAYS=30
NOEMA_PUBLIC_DATASET_OPT_IN=false
NOEMA_CAPTURE_AGENT_MESSAGES=true
NOEMA_CAPTURE_TOOL_CALLS=true
NOEMA_CAPTURE_SELF_REPORTS=true

# SECURITY
NOEMA_ALLOWED_AGENT_ORIGINS=http://localhost:3000
NOEMA_RATE_LIMIT_PER_MINUTE=120
NOEMA_MAX_ACTION_PAYLOAD_BYTES=65536
NOEMA_SANDBOX_MODE=strict
NOEMA_OUTBOUND_NETWORK_POLICY=deny

# FEATURE FLAGS. Experimental systems default off.
NOEMA_FEATURE_FRONTIER_DIRECTOR=false
NOEMA_FEATURE_PHENOMENON_COMPILER=false
NOEMA_FEATURE_DEEP_TIME=false
NOEMA_FEATURE_AGENT_INSTITUTIONS=false
NOEMA_FEATURE_PHENOMENA_LAB=false
