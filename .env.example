# =============================================================================
# CORE — required for local v0.1 golden path (Chamber boots with these + defaults)
# =============================================================================
NOEMA_ENV=local
NOEMA_APP_URL=http://localhost:3000

DATABASE_URL=postgres://noema:noema@localhost:5432/noema
AUTH_SECRET=change-me

NOEMA_WORLD_ID=world-01
NOEMA_WORLD_SEED=noema-local-seed
NOEMA_MAX_AGENTS=10

# =============================================================================
# HUMAN AUTH (Supabase Auth) — optional for local agent-token / fixture boot;
# required for hosted human PLAY login (Render + Supabase stack)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# =============================================================================
# ADVANCED OPERATIONS — safe local defaults; override as needed
# =============================================================================
NOEMA_API_URL=http://localhost:3000/api
NOEMA_WS_URL=ws://localhost:3000/ws
NOEMA_LOG_LEVEL=info

HOST=127.0.0.1
PORT=3000
WORKER_COUNT=1
REQUEST_TIMEOUT_MS=30000

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

SESSION_SECRET=change-me
TOKEN_SIGNING_SECRET=change-me
AGENT_API_KEY_PEPPER=change-me

NOEMA_TICK_INTERVAL_MS=1000
NOEMA_SNAPSHOT_INTERVAL=100
NOEMA_ATTENTION_BUDGET_DEFAULT=8
NOEMA_COMPUTE_BUDGET_DEFAULT=64
NOEMA_ENERGY_BUDGET_DEFAULT=80
NOEMA_INFLUENCE_BUDGET_DEFAULT=40
NOEMA_STORAGE_BUDGET_DEFAULT=16

NOEMA_DETERMINISTIC_MODE=true
NOEMA_REPLAY_VERIFY=true
NOEMA_REPLAY_STORAGE_PATH=./var/replays

# Local filesystem object storage (no external MinIO/S3 required)
NOEMA_OBJECT_STORAGE_ADAPTER=filesystem
NOEMA_OBJECT_STORAGE_PATH=./var/objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=noema-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

NOEMA_ALLOWED_AGENT_ORIGINS=http://localhost:3000
NOEMA_RATE_LIMIT_PER_MINUTE=60
NOEMA_MAX_ACTION_PAYLOAD_BYTES=32768
NOEMA_SANDBOX_MODE=strict
NOEMA_OUTBOUND_NETWORK_POLICY=deny-by-default

# Optional observability — empty means disabled; not required for local boot
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=noema-local
SENTRY_DSN=
METRICS_ENABLED=true

NOEMA_FEATURE_FRONTIER_DIRECTOR=false
NOEMA_FEATURE_PHENOMENON_COMPILER=false
NOEMA_FEATURE_DEEP_TIME=true
NOEMA_FEATURE_AGENT_INSTITUTIONS=false
NOEMA_FEATURE_PHENOMENA_LAB=false

# =============================================================================
# RESEARCH — defaults fail closed for public export
# =============================================================================
NOEMA_RESEARCH_ENABLED=false
NOEMA_TRAJECTORY_RETENTION_DAYS=30
NOEMA_PUBLIC_DATASET_OPT_IN=false
NOEMA_CAPTURE_AGENT_MESSAGES=true
NOEMA_CAPTURE_TOOL_CALLS=true
NOEMA_CAPTURE_SELF_REPORTS=false

# =============================================================================
# PROVIDER INTEGRATIONS — optional; NOT required for external agents to join
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL SCALING — not required for v0.1 local Chamber
# =============================================================================
REDIS_URL=
QUEUE_CONCURRENCY=4
