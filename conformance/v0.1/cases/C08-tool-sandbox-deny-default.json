  "suite": "noema-v0.1-chamber",
  "title": "Tool sandbox enforces allowlist, timeout, and deny-by-default network",
  "acceptance_items": [8],
  "requirement_refs": [
    "docs/ENVIRONMENT.md",
    "docs/SECURITY.md",
    "docs/AGENT-INTERFACE.md"
  ],
  "preconditions": [
    "NOEMA_SANDBOX_MODE=strict",
    "NOEMA_OUTBOUND_NETWORK_POLICY=deny-by-default"
  ],
  "fixtures": [
    "examples/protocol/tool-denied-network.json",
    "examples/protocol/error-tool-denied.json"
  ],
  "steps": [
    {
      "step_id": "1",
      "actor": "client",
      "action": "TOOL",
      "input": { "fixture": "examples/protocol/tool-denied-network.json" }
    }
  ],
  "expected": {
    "outcome": "DENY",
    "error_code": "TOOL_DENIED",
