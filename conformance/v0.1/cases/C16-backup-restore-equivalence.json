  "title": "Backup and restore preserve world-state digest, ledger head, snapshot lineage, and runtime manifest",
  "acceptance_items": [16],
  "requirement_refs": [
    "docs/OPERATIONS.md",
    "docs/REPLAY.md",
    "examples/deployment/verify-pass.example.txt"
  ],
  "preconditions": [
    "Known Chamber state exists with non-genesis ledger head",
    "noema backup / restore / verify commands are available"
  ],
  "fixtures": [
    "examples/deployment/local-runtime-manifest.json",
    "examples/deployment/verify-pass.example.txt",
    "examples/v01-seed/equivalence-boundary.json"
  ],
  "steps": [
    {
      "step_id": "1",
      "actor": "operator",
      "action": "BACKUP",
      "input": { "command": "noema backup" },
      "notes": "Backup known Chamber state"
    },
    {
      "step_id": "2",
      "actor": "operator",
      "action": "RESTORE",
      "input": { "command": "noema restore <bundle>" },
      "notes": "Restore into clean compatible environment"
    },
    {
      "step_id": "3",
      "actor": "operator",
      "action": "VERIFY",
      "input": { "command": "noema verify" }
    },
    {
      "step_id": "4",
      "actor": "world-engine",
      "action": "COMPARE",
      "input": {
        "fields": [
          "world_state_digest",
          "ledger_head",
          "snapshot_lineage",
          "runtime_manifest",
          "replay_equivalence"
        ]
      }
    }
  ],
  "expected": {
    "outcome": "EQUIVALENT",
    "assertions": [
      "Backup captures known Chamber state",
      "Restore into clean compatible environment succeeds",
      "World-state digest matches pre-backup",
      "Ledger head matches pre-backup",
      "Snapshot lineage matches pre-backup",
      "Runtime manifest matches required version fields",
      "Replay remains equivalent under ADR-005 boundary",
      "noema verify prints NOEMA VERIFY: PASS"
    ]
  },
  "security_class": "none"
