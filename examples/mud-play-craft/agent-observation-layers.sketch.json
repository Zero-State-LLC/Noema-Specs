{
  "schema_version": "mud-play-craft-observation-sketch/0.1",
  "status": "NON_NORMATIVE_SKETCH",
  "note": "Conceptual agent layer mapping for Feature B + MUD-PLAY-CRAFT. Not a wire protocol. Do not implement as required JSON Schema without RFC.",
  "feature_b_order": [
    "place",
    "description",
    "pressure",
    "here",
    "exits",
    "status",
    "happened",
    "available_here"
  ],
  "layers": {
    "place": {
      "fields": ["name", "room_id"],
      "human_default": ["name"],
      "example": { "name": "Relay Quarter", "room_id": "room.relay-quarter" }
    },
    "description": {
      "fields": ["static_text"],
      "rules": ["no_live_stock", "no_player_lists", "no_global_report_bleed"]
    },
    "pressure": {
      "fields": ["summary", "keywords"],
      "rules": ["room_local_only", "optional_if_quiet"]
    },
    "here": {
      "players": [{ "handle": "string", "visibility": "public_co_located" }],
      "entities": [
        {
          "label": "relay-main",
          "entity_id": "entity.relay-main",
          "entity_type": "INFRASTRUCTURE",
          "condition_band": "worn",
          "condition_integer": { "when": "full_attention_or_advanced", "value": 70 }
        }
      ]
    },
    "exits": [
      {
        "direction": "south",
        "destination_name": "Civic Exchange",
        "destination_room_id": "room.civic-exchange",
        "traversal_cost": null
      },
      {
        "direction": "down",
        "destination_name": "Infrastructure Vault",
        "destination_room_id": "room.infrastructure-vault",
        "traversal_cost": { "energy": 1 }
      }
    ],
    "status": {
      "budgets": {
        "energy": 79,
        "attention": 7,
        "compute": 64,
        "storage": 16,
        "influence": 40
      },
      "flags": {
        "energy_floor_risk": false,
        "play_blocked": false
      },
      "rules": ["existing_budgets_only", "no_xp_hp_research_scores"]
    },
    "happened": {
      "four_beat": {
        "tried": "MOVE south from Civic Exchange",
        "outcome": "OK",
        "changed": ["location"],
        "next_affordances": ["inspect relay-main", "repair relay-main", "walk south"]
      },
      "prose": "You reach Relay Quarter from the south.",
      "error_code_advanced_only": null
    },
    "available_here": [
      {
        "canonical_verb": "INSPECT",
        "target_label": "relay-main",
        "target_id": "entity.relay-main"
      },
      {
        "canonical_verb": "COMMIT",
        "parameters": { "operation": "REPAIR" },
        "target_label": "relay-main",
        "target_id": "entity.relay-main"
      },
      {
        "canonical_verb": "MOVE",
        "parameters": { "direction": "south" }
      }
    ]
  },
  "attention_degrade": {
    "ref": "docs/ATTENTION-PROJECTION.md",
    "minimal_keeps": ["place.name", "exits.direction"],
    "reduced_omits": ["condition_integer", "stock_available_detail"]
  },
  "seed_refs": {
    "world_seed": "examples/chamber-world/world-seed.json",
    "rooms": [
      "room.civic-exchange",
      "room.relay-quarter",
      "room.foundry-corridor"
    ]
  }
}
